# ── Green Platform — environment variables ──
# Copy to .env.local and fill in what you have. Everything is optional.

NEXT_PUBLIC_SITE_URL=https://greenplatform.ch

# Inquiry email notifications (https://resend.com). Without a key, inquiries are logged to the server console.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=hello@greenplatform.ch
LEAD_FROM_EMAIL=hello@greenplatform.ch

# Analytics (load only after cookie consent)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
